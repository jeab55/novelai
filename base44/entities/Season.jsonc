{
  "name": "Season",
  "type": "object",
  "properties": {
    "novel_id": {
      "type": "string",
      "description": "ID \u0e02\u0e2d\u0e07\u0e19\u0e34\u0e22\u0e32\u0e22\u0e2b\u0e25\u0e31\u0e01 (Series)"
    },
    "season_number": {
      "type": "number",
      "description": "\u0e40\u0e25\u0e02\u0e17\u0e35\u0e48 Season (1, 2, 3...)"
    },
    "title": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d Season (\u0e40\u0e0a\u0e48\u0e19 'Season 1: \u0e08\u0e38\u0e14\u0e40\u0e23\u0e34\u0e48\u0e21\u0e15\u0e49\u0e19')"
    },
    "description": {
      "type": "string",
      "description": "\u0e04\u0e33\u0e2d\u0e18\u0e34\u0e1a\u0e32\u0e22 Season"
    },
    "writer_id": {
      "type": "string",
      "description": "ID \u0e02\u0e2d\u0e07\u0e19\u0e31\u0e01\u0e40\u0e02\u0e35\u0e22\u0e19 AI \u0e17\u0e35\u0e48 lock \u0e44\u0e27\u0e49\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a Season \u0e19\u0e35\u0e49"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0e01\u0e33\u0e25\u0e31\u0e07\u0e40\u0e02\u0e35\u0e22\u0e19",
        "\u0e40\u0e02\u0e35\u0e22\u0e19\u0e40\u0e2a\u0e23\u0e47\u0e08",
        "\u0e1e\u0e31\u0e01\u0e44\u0e27\u0e49"
      ],
      "default": "\u0e01\u0e33\u0e25\u0e31\u0e07\u0e40\u0e02\u0e35\u0e22\u0e19"
    },
    "total_chapters": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e15\u0e2d\u0e19\u0e17\u0e31\u0e49\u0e07\u0e2b\u0e21\u0e14\u0e43\u0e19 Season \u0e19\u0e35\u0e49"
    }
  },
  "required": [
    "novel_id",
    "season_number",
    "title"
  ]
}