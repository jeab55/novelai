    },
    "name": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e15\u0e31\u0e27\u0e25\u0e30\u0e04\u0e23"
    },
    "role": {
      "type": "string",
      "enum": [
        "\u0e15\u0e31\u0e27\u0e40\u0e2d\u0e01",
        "\u0e15\u0e31\u0e27\u0e23\u0e2d\u0e07",
        "\u0e15\u0e31\u0e27\u0e23\u0e49\u0e32\u0e22",
        "\u0e15\u0e31\u0e27\u0e1b\u0e23\u0e30\u0e01\u0e2d\u0e1a"
      ],
      "description": "\u0e1a\u0e17\u0e1a\u0e32\u0e17"
    },
    "age": {
      "type": "string",
      "description": "\u0e2d\u0e32\u0e22\u0e38"
    },
    "occupation": {
      "type": "string",
      "description": "\u0e2d\u0e32\u0e0a\u0e35\u0e1e"
    },
    "appearance": {
      "type": "string",
      "description": "\u0e25\u0e31\u0e01\u0e29\u0e13\u0e30\u0e20\u0e32\u0e22\u0e19\u0e2d\u0e01"
    },
    "personality": {
      "type": "string",
      "description": "\u0e19\u0e34\u0e2a\u0e31\u0e22\u0e41\u0e25\u0e30\u0e1a\u0e38\u0e04\u0e25\u0e34\u0e01"
    },
    "voice_profile": {
      "type": "string",
      "description": "\ud83c\udf99\ufe0f \u0e25\u0e32\u0e22\u0e19\u0e34\u0e49\u0e27\u0e21\u0e37\u0e2d\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e1e\u0e39\u0e14 (Voice Profile): \u0e04\u0e33\u0e15\u0e34\u0e14\u0e1b\u0e32\u0e01, \u0e08\u0e31\u0e07\u0e2b\u0e27\u0e30\u0e1b\u0e23\u0e30\u0e42\u0e22\u0e04 (\u0e2a\u0e31\u0e49\u0e19\u0e2b\u0e49\u0e27\u0e19/\u0e22\u0e32\u0e27\u0e40\u0e23\u0e37\u0e48\u0e2d\u0e22), \u0e2a\u0e23\u0e23\u0e1e\u0e19\u0e32\u0e21/\u0e04\u0e33\u0e25\u0e07\u0e17\u0e49\u0e32\u0e22\u0e17\u0e35\u0e48\u0e43\u0e0a\u0e49, \u0e23\u0e30\u0e14\u0e31\u0e1a\u0e20\u0e32\u0e29\u0e32 (\u0e17\u0e32\u0e07\u0e01\u0e32\u0e23/\u0e01\u0e31\u0e19\u0e40\u0e2d\u0e07/\u0e2b\u0e22\u0e32\u0e1a), \u0e41\u0e25\u0e30\u0e1b\u0e23\u0e30\u0e42\u0e22\u0e04\u0e40\u0e2d\u0e01\u0e25\u0e31\u0e01\u0e29\u0e13\u0e4c\u0e17\u0e35\u0e48\u0e21\u0e35\u0e41\u0e15\u0e48\u0e15\u0e31\u0e27\u0e25\u0e30\u0e04\u0e23\u0e19\u0e35\u0e49\u0e1e\u0e39\u0e14\u0e44\u0e14\u0e49 \u2014 \u0e43\u0e0a\u0e49\u0e2d\u0e49\u0e32\u0e07\u0e2d\u0e34\u0e07\u0e15\u0e2d\u0e19\u0e40\u0e02\u0e35\u0e22\u0e19\u0e1a\u0e17\u0e2a\u0e19\u0e17\u0e19\u0e32\u0e43\u0e2b\u0e49\u0e04\u0e07\u0e40\u0e2a\u0e35\u0e22\u0e07\u0e40\u0e14\u0e34\u0e21\u0e17\u0e38\u0e01\u0e15\u0e2d\u0e19"
    },
    "address_terms": {
      "type": "string",
      "description": "\ud83d\udde3\ufe0f \u0e2a\u0e23\u0e23\u0e1e\u0e19\u0e32\u0e21 & \u0e04\u0e33\u0e40\u0e23\u0e35\u0e22\u0e01\u0e02\u0e32\u0e19 (\u0e23\u0e32\u0e22\u0e04\u0e39\u0e48): \u0e15\u0e31\u0e27\u0e25\u0e30\u0e04\u0e23\u0e40\u0e23\u0e35\u0e22\u0e01\u0e15\u0e31\u0e27\u0e40\u0e2d\u0e07\u0e27\u0e48\u0e32\u0e2d\u0e30\u0e44\u0e23 \u0e41\u0e25\u0e30\u0e40\u0e23\u0e35\u0e22\u0e01\u0e15\u0e31\u0e27\u0e25\u0e30\u0e04\u0e23\u0e2d\u0e37\u0e48\u0e19\u0e41\u0e15\u0e48\u0e25\u0e30\u0e04\u0e19\u0e27\u0e48\u0e32\u0e2d\u0e30\u0e44\u0e23 (\u0e23\u0e32\u0e22\u0e04\u0e39\u0e48) \u0e23\u0e27\u0e21\u0e16\u0e36\u0e07\u0e08\u0e31\u0e07\u0e2b\u0e27\u0e30\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e04\u0e33\u0e40\u0e23\u0e35\u0e22\u0e01\u0e15\u0e32\u0e21\u0e1e\u0e31\u0e12\u0e19\u0e32\u0e01\u0e32\u0e23\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e31\u0e21\u0e1e\u0e31\u0e19\u0e18\u0e4c (\u0e15\u0e2d\u0e19\u0e15\u0e49\u0e19\u2192\u0e2a\u0e19\u0e34\u0e17\u2192\u0e08\u0e38\u0e14\u0e1e\u0e35\u0e04) \u0e40\u0e0a\u0e48\u0e19 '\u0e04\u0e38\u0e13\u0e40\u0e19\u0e22\u2192\u0e40\u0e19\u0e22' \u0e2b\u0e23\u0e37\u0e2d\u0e40\u0e25\u0e34\u0e01\u0e25\u0e07\u0e17\u0e49\u0e32\u0e22 '\u0e04\u0e23\u0e31\u0e1a' \u2014 \u0e43\u0e0a\u0e49\u0e43\u0e2b\u0e49 AI \u0e40\u0e02\u0e35\u0e22\u0e19\u0e1a\u0e17\u0e2a\u0e19\u0e17\u0e19\u0e32\u0e43\u0e0a\u0e49\u0e04\u0e33\u0e40\u0e23\u0e35\u0e22\u0e01\u0e16\u0e39\u0e01\u0e41\u0e25\u0e30\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e04\u0e33\u0e40\u0e23\u0e35\u0e22\u0e01\u0e43\u0e2b\u0e49\u0e15\u0e23\u0e07\u0e08\u0e31\u0e07\u0e2b\u0e27\u0e30\u0e2d\u0e32\u0e23\u0e21\u0e13\u0e4c"
    },
    "background": {
      "type": "string",
      "description": "\u0e1b\u0e39\u0e21\u0e2b\u0e25\u0e31\u0e07"
    },
    "desire": {
      "type": "string",
      "description": "\u0e2a\u0e34\u0e48\u0e07\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23"
    },
    "wound": {
      "type": "string",
      "description": "\u0e2a\u0e34\u0e48\u0e07\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e01\u0e32\u0e23\u0e08\u0e23\u0e34\u0e07 (need) \u0e23\u0e27\u0e21\u0e01\u0e31\u0e1a\u0e1b\u0e21\u0e43\u0e19\u0e43\u0e08 (wound)"
    },
    "relationships": {
      "type": "string",
      "description": "\u0e04\u0e27\u0e32\u0e21\u0e2a\u0e31\u0e21\u0e1e\u0e31\u0e19\u0e18\u0e4c\u0e01\u0e31\u0e1a\u0e15\u0e31\u0e27\u0e25\u0e30\u0e04\u0e23\u0e2d\u0e37\u0e48\u0e19"
    },
    "ai_analysis": {
      "type": "string",
      "description": "\u0e1c\u0e25\u0e27\u0e34\u0e40\u0e04\u0e23\u0e32\u0e30\u0e2b\u0e4c\u0e15\u0e31\u0e27\u0e25\u0e30\u0e04\u0e23\u0e08\u0e32\u0e01 AI"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "soft delete flag"
    }
  },
  "required": [
    "novel_id",
    "name"
  ]
}