{
  "name": "Chapter",
  "type": "object",
  "properties": {
    "novel_id": {
      "type": "string",
      "description": "ID \u0e02\u0e2d\u0e07\u0e19\u0e34\u0e22\u0e32\u0e22\u0e17\u0e35\u0e48\u0e2a\u0e31\u0e07\u0e01\u0e31\u0e14"
    },
    "title": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e15\u0e2d\u0e19"
    },
    "content": {
      "type": "string",
      "description": "\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e32"
    },
    "previous_content": {
      "type": "string",
      "description": "\u0e2a\u0e33\u0e23\u0e2d\u0e07\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e32\u0e40\u0e14\u0e34\u0e21\u0e01\u0e48\u0e2d\u0e19\u0e01\u0e32\u0e23\u0e1b\u0e23\u0e31\u0e1a\u0e1b\u0e23\u0e38\u0e07\u0e15\u0e32\u0e21\u0e23\u0e35\u0e27\u0e34\u0e27"
    },
    "order": {
      "type": "number",
      "description": "\u0e25\u0e33\u0e14\u0e31\u0e1a\u0e15\u0e2d\u0e19"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u0e23\u0e48\u0e32\u0e07",
        "\u0e40\u0e02\u0e35\u0e22\u0e19\u0e40\u0e2a\u0e23\u0e47\u0e08",
        "\u0e40\u0e1c\u0e22\u0e41\u0e1e\u0e23\u0e48"
      ],
      "default": "\u0e23\u0e48\u0e32\u0e07"
    },
    "word_count": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e04\u0e33"
    },
    "editor_review": {
      "type": "string",
      "description": "\u0e1a\u0e31\u0e19\u0e17\u0e36\u0e01\u0e1a\u0e23\u0e23\u0e13\u0e32\u0e18\u0e34\u0e01\u0e32\u0e23 / \u0e04\u0e33\u0e41\u0e19\u0e30\u0e19\u0e33\u0e23\u0e35\u0e27\u0e34\u0e27\u0e15\u0e2d\u0e19\u0e19\u0e35\u0e49"
    },
    "plot_event_id": {
      "type": "string",
      "description": "ID \u0e02\u0e2d\u0e07\u0e40\u0e2b\u0e15\u0e38\u0e01\u0e32\u0e23\u0e13\u0e4c\u0e44\u0e17\u0e21\u0e4c\u0e44\u0e25\u0e19\u0e4c\u0e17\u0e35\u0e48\u0e1c\u0e39\u0e01\u0e2d\u0e22\u0e39\u0e48"
    },
    "plot_event_title": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e2b\u0e15\u0e38\u0e01\u0e32\u0e23\u0e13\u0e4c\u0e44\u0e17\u0e21\u0e4c\u0e44\u0e25\u0e19\u0e4c\u0e17\u0e35\u0e48\u0e1c\u0e39\u0e01\u0e2d\u0e22\u0e39\u0e48"
    },
    "plot_event_description": {
      "type": "string",
      "description": "\u0e04\u0e33\u0e2d\u0e18\u0e34\u0e1a\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38\u0e01\u0e32\u0e23\u0e13\u0e4c\u0e44\u0e17\u0e21\u0e4c\u0e44\u0e25\u0e19\u0e4c\u0e17\u0e35\u0e48\u0e1c\u0e39\u0e01\u0e2d\u0e22\u0e39\u0e48"
    },
    "plot_event_order": {
      "type": "number",
      "description": "\u0e25\u0e33\u0e14\u0e31\u0e1a\u0e40\u0e2b\u0e15\u0e38\u0e01\u0e32\u0e23\u0e13\u0e4c\u0e44\u0e17\u0e21\u0e4c\u0e44\u0e25\u0e19\u0e4c\u0e17\u0e35\u0e48\u0e1c\u0e39\u0e01\u0e2d\u0e22\u0e39\u0e48"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "soft delete flag"
    },
    "illustration_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23 URL \u0e20\u0e32\u0e1e\u0e1b\u0e23\u0e30\u0e01\u0e2d\u0e1a\u0e17\u0e35\u0e48\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e14\u0e49\u0e27\u0e22 AI \u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e15\u0e2d\u0e19\u0e19\u0e35\u0e49"
    }
  },
  "required": [
    "novel_id",
    "title"
  ]
}