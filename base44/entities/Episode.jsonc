{
  "name": "Episode",
  "type": "object",
  "properties": {
    "novel_id": {
      "type": "string",
      "description": "ID \u0e02\u0e2d\u0e07\u0e19\u0e34\u0e22\u0e32\u0e22\u0e17\u0e35\u0e48\u0e2a\u0e31\u0e07\u0e01\u0e31\u0e14"
    },
    "title": {
      "type": "string",
      "description": "\u0e0a\u0e37\u0e48\u0e2d\u0e15\u0e2d\u0e19"
    },
    "episode_number": {
      "type": "number",
      "description": "\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e25\u0e02\u0e15\u0e2d\u0e19"
    },
    "content": {
      "type": "string",
      "description": "\u0e40\u0e19\u0e37\u0e49\u0e2d\u0e2b\u0e32\u0e15\u0e2d\u0e19"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft",
      "description": "\u0e2a\u0e16\u0e32\u0e19\u0e30\u0e15\u0e2d\u0e19"
    },
    "published_at": {
      "type": "string",
      "description": "\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e40\u0e1c\u0e22\u0e41\u0e1e\u0e23\u0e48 (ISO string)"
    },
    "word_count": {
      "type": "number",
      "default": 0,
      "description": "\u0e08\u0e33\u0e19\u0e27\u0e19\u0e04\u0e33"
    }
  },
  "required": [
    "novel_id",
    "title",
    "episode_number"
  ]
}